      color: white;
      font-family: Arial, sans-serif;
      text-align: center;
    }

    h1 {
      margin: 20px 0 8px;
      color: #00eaff;
    }

    p {
      color: #b8c4d6;
    }

    .camera-box {
      position: relative;
      width: 90%;
      max-width: 900px;
      margin: 20px auto;
      border: 3px solid #00eaff;
      border-radius: 15px;
      overflow: hidden;
      background: black;
    }

    video {
      width: 100%;
      display: block;
      transform: scaleX(-1);
    }

    canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      transform: scaleX(-1);
    }

    button {
      padding: 14px 28px;
      font-size: 16px;
      border: none;
      border-radius: 8px;
      background: #00eaff;
      color: #001018;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #00bcd4;
    }

    #status {
      margin: 15px;
      color: #7dff9b;
    }
  </style>
</head>

